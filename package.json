{
  "name": "repo-atlas",
  "version": "0.1.0",
  "description": "Evidence-linked, self-contained static overviews of a repository: a decision trail with rejected alternatives, honest edges, and ranked deep dives, every claim pinned to a commit.",
  "keywords": [
    "codebase",
    "documentation",
    "static-site",
    "evidence",
    "architecture"
  ],
  "homepage": "https://github.com/KyleNaluan/repo-atlas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyleNaluan/repo-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/KyleNaluan/repo-atlas/issues"
  },
  "type": "module",
  "bin": {
    "repo-atlas": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./schema/atlas.schema.json",
    "./render": "./dist/render/index.js"
  },
  "files": [
    "dist",
    "schema",
    "assets",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:gen": "tsx scripts/gen-schema.ts",
    "schema:check": "tsx scripts/gen-schema.ts --check",
    "atlas": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ts-json-schema-generator": "^2.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "license": "UNLICENSED",
  "private": false,
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.227",
    "@hpcc-js/wasm-graphviz": "^1.28.0",
    "ajv": "^8.20.0",
    "puppeteer-core": "^25.5.0",
    "shiki": "^3.23.0",
    "web-tree-sitter": "^0.20.8"
  }
}
